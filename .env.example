DATABASE_URL=postgres://user:password@localhost:5432/porta
BETTER_AUTH_SECRET=change-me-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3000
# Set to 1 when DATABASE_URL points at a transaction pooler (pgbouncer/Neon pooler)
#DATABASE_POOLED=1

# Email (password reset, invite delivery). RESEND_API_KEY is provisioned on
# Vercel by the Resend Marketplace integration; set it (and EMAIL_FROM) in the
# Docker env too. Without RESEND_API_KEY, email is skipped (fine for local
# dev). When RESEND_API_KEY IS set, EMAIL_FROM is required and must be an
# address on a Resend-verified domain — the onboarding@resend.dev tester only
# delivers to the account owner, so other recipients would silently 403.
#RESEND_API_KEY=re_xxxxxxxx
#EMAIL_FROM=Silicon Ecosystem <no-reply@your-verified-domain.com>

# Set to 1 when a reverse proxy you control sits in front, rewrites
# x-forwarded-for, AND the app cannot be reached any other way. Auth rate
# limiting then keys on the real client address instead of pooling everyone
# into one bucket per endpoint. Both halves matter: if the app is still
# reachable directly, a client goes around the proxy, forges the header, and
# gets a fresh bucket per request — worse than leaving this unset. Vercel is
# detected automatically and needs nothing here.
#TRUST_PROXY_HEADERS=1

# Set to 1 to send the Content-Security-Policy as report-only: violations show
# up in the browser console and nothing is blocked. Use it for a deploy or two
# after changing the policy, then unset it to enforce.
#CSP_REPORT_ONLY=1
