DATABASE_URL=postgres://user:password@localhost:5432/porta
BETTER_AUTH_SECRET=change-me-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3000
# Set to 1 when DATABASE_URL points at a transaction pooler (pgbouncer/Neon pooler)
#DATABASE_POOLED=1

# Email (password reset, invite delivery). RESEND_API_KEY is provisioned on
# Vercel by the Resend Marketplace integration; set it (and EMAIL_FROM) in the
# Docker env too. Without RESEND_API_KEY, email is skipped (fine for local
# dev). When RESEND_API_KEY IS set, EMAIL_FROM is required and must be an
# address on a Resend-verified domain — the onboarding@resend.dev tester only
# delivers to the account owner, so other recipients would silently 403.
#RESEND_API_KEY=re_xxxxxxxx
#EMAIL_FROM=Silicon Ecosystem <no-reply@your-verified-domain.com>
