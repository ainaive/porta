{
  "name": "porta",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:vercel": "node scripts/migrate.mjs && next build",
    "start": "next start",
    "lint": "eslint --max-warnings 0",
    "format": "biome check --write .",
    "format:check": "biome ci .",
    "typecheck": "next typegen && tsc --noEmit",
    "verify": "biome ci . && bun run lint && bun run typecheck && bun run i18n:check && bun test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.mjs",
    "db:seed": "bun scripts/seed.ts",
    "i18n:check": "bun scripts/check-messages.ts",
    "test": "bun test src/ scripts/ tests/",
    "test:unit": "bun test src/ scripts/",
    "test:db": "bun test tests/db/",
    "test:e2e": "bun e2e/prepare-db.ts && next build && playwright test",
    "auth:schema": "better-auth generate --config src/lib/auth.ts --output src/db/schema/auth.ts --yes"
  },
  "dependencies": {
    "better-auth": "^1.6.26",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.29.0",
    "nanoid": "^6.0.1",
    "next": "16.3.0",
    "next-intl": "^4.13.5",
    "next-themes": "^0.4.6",
    "postgres": "^3.4.9",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.16.2",
    "sharp": "^0.35.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@better-auth/cli": "^1.4.21",
    "@biomejs/biome": "^2.5.7",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@types/bun": "^1.3.14",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  },
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=24"
  },
  "overrides": {
    "@types/node": "^24.13.3"
  },
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
